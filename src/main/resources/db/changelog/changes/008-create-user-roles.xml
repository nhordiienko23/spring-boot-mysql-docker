<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="14-create-user-roles-table" author="Nikita Hordiienko">
        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="user_roles"
                                 constraintName="fk_user_roles_user"
                                 referencedColumnNames="user_id"
                                 referencedTableName="users"/>
    </changeSet>


    <changeSet id="15-insert-initial-roles" author="Nikita Hordiienko">
        <insert tableName="user_roles">
            <column name="user_id" value="1"/>
            <column name="role" value="ROLE_ADMIN"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" value="1"/>
            <column name="role" value="ROLE_USER"/>
        </insert>


        <insert tableName="user_roles"><column name="user_id" value="2"/><column name="role" value="ROLE_USER"/></insert>
        <insert tableName="user_roles"><column name="user_id" value="3"/><column name="role" value="ROLE_USER"/></insert>
        <insert tableName="user_roles"><column name="user_id" value="4"/><column name="role" value="ROLE_USER"/></insert>
        <insert tableName="user_roles"><column name="user_id" value="5"/><column name="role" value="ROLE_USER"/></insert>
        <insert tableName="user_roles"><column name="user_id" value="6"/><column name="role" value="ROLE_USER"/></insert>
    </changeSet>

</databaseChangeLog>